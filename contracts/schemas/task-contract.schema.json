{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rahemih/Finance/contracts/schemas/task-contract.schema.json",
  "title": "Finance Governed Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id", "phase", "workstream", "objective", "scope", "out_of_scope",
    "dependencies", "read_paths", "write_paths", "forbidden_paths", "agents",
    "plugins", "skills", "access", "risk_level", "tests", "evidence",
    "rollback", "human_gate", "definition_of_ready", "definition_of_done"
  ],
  "properties": {
    "task_id": {"type": "string", "pattern": "^FIN-P[0-9]{2}-W[A-Z]-[0-9]{3}(?:-R[0-9]{2})?$"},
    "phase": {"type": "string", "pattern": "^P[0-9]{2}$"},
    "workstream": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "items": {"type": "string"}},
    "out_of_scope": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "read_paths": {"type": "array", "items": {"type": "string"}},
    "write_paths": {"type": "array", "items": {"type": "string"}},
    "forbidden_paths": {"type": "array", "items": {"type": "string"}},
    "agents": {"type": "array", "items": {"type": "string"}},
    "plugins": {"type": "array", "items": {"type": "string"}},
    "skills": {"type": "array", "items": {"type": "string"}},
    "access": {"type": "array", "items": {"type": "string"}},
    "secrets": {"type": "array", "items": {"type": "string"}, "default": []},
    "risk_level": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "tests": {"type": "array", "items": {"type": "string"}},
    "performance_tests": {"type": "array", "items": {"type": "string"}, "default": []},
    "security_tests": {"type": "array", "items": {"type": "string"}, "default": []},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "rollback": {"type": "string", "minLength": 1},
    "human_gate": {"type": "boolean"},
    "definition_of_ready": {"type": "array", "items": {"type": "string"}},
    "definition_of_done": {"type": "array", "items": {"type": "string"}}
  }
}
