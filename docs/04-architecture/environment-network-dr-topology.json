      "real_account_access": "DISABLED_UNTIL_G13_PATH",
      "execution_capability": "DISABLED_IN_P02",
      "credential_class": "SEPARATE_LIVE_CREDENTIALS",
      "promotion_target": "NONE"
    }
  ],
  "trust_zones": [
    {
      "id": "Z0_USER_EDGE",
      "purpose": "owner/team client/browser/mobile entry",
      "internet_exposed": "CLIENT_SIDE_ONLY",
      "allowed_outbound": [
        "Z1_APPLICATION_INGRESS"
      ],
      "forbidden_direct": [
        "Z3_DATA_PLANE",
        "Z4_EXECUTION_ENCLAVE",
        "Z5_SECURITY_SECRETS",
        "Z7_BACKUP_DR"
      ]
    },
    {
      "id": "Z1_APPLICATION_INGRESS",
      "purpose": "authenticated API/UI boundary and future notification ingress",
      "internet_exposed": "CONTROLLED",
      "allowed_outbound": [
        "Z2_CONTROL_PLANE",
        "read models in Z3"
      ],
      "forbidden_direct": [
        "broker/exchange order endpoints",
        "raw secrets"
      ]
    },
    {
      "id": "Z2_CONTROL_PLANE",
      "purpose": "governance, agent orchestration, workflow/control APIs",
      "internet_exposed": "NO_DIRECT_PUBLIC",
      "allowed_outbound": [
        "authorized domain APIs",
        "Z6_OBSERVABILITY_AUDIT",
        "Z5 via credential handles only"
      ],
      "forbidden_direct": [
        "provider credentials",
        "broker mutation outside D12/D11 path"
      ]
    },
    {
      "id": "Z3_DATA_PLANE",
      "purpose": "market-data adapters, canonical streams, storage, features, research data",
      "internet_exposed": "NO_DIRECT_PUBLIC",
      "allowed_outbound": [
        "external market/macro/news providers through controlled adapter egress",
        "Z6_OBSERVABILITY_AUDIT"
      ],
      "forbidden_direct": [
        "live broker order mutation",
        "raw secret disclosure"
      ]
    },
    {
      "id": "Z4_EXECUTION_ENCLAVE",
      "purpose": "Risk/Firewall/OMS/execution adapters and reconciliation",
      "internet_exposed": "NO",
      "allowed_outbound": [
        "approved broker/exchange endpoints",
        "Z5 credential handle resolution",
        "Z6_OBSERVABILITY_AUDIT"
      ],
      "ingress_from": [
        "authorized internal Risk/OMS contracts only"
      ],
      "forbidden_direct": [
        "Z0_USER_EDGE",
        "untrusted agent text",
        "general web/news content"
      ]
    },
    {
      "id": "Z5_SECURITY_SECRETS",
      "purpose": "identity, authorization, secret/KMS/vault abstractions",
      "internet_exposed": "NO",
      "allowed_outbound": [
        "identity/security providers if later selected"
      ],
      "access_rule": "least privilege; service/role scoped; no bulk secret reads"
    },
    {
      "id": "Z6_OBSERVABILITY_AUDIT",
      "purpose": "logs, metrics, traces, security events, audit/evidence",
      "internet_exposed": "NO_DIRECT_PUBLIC",
      "write_sources": [
        "all zones through controlled sinks"
      ],
      "authority": "observe/audit; no hidden business-state mutation"
    },
    {
      "id": "Z7_BACKUP_DR",
      "purpose": "backup copies, recovery manifests, restore staging",
      "internet_exposed": "NO",
      "access_rule": "restricted; separate credentials/keys later; restore through validation/quarantine path"
    }
  ],
  "external_boundaries": [
    {
      "id": "EXT_MARKET_DATA",
      "access": "OUTBOUND_FROM_CONTROLLED_ADAPTERS",
      "inbound_mutation": "FORBIDDEN"
    },
    {
      "id": "EXT_MACRO_NEWS",
      "access": "OUTBOUND_FETCH_OR_VALIDATED_CALLBACK",
      "inbound_mutation": "UNTRUSTED_DATA_ONLY"
    },
    {
      "id": "EXT_BROKER_EXCHANGE",
      "access": "OUTBOUND_FROM_Z4_ONLY",
      "inbound_events": "VALIDATED_ACK_FILL_STATUS_CALLBACK_OR_POLL",
      "rule": "provider event cannot bypass OMS/reconciliation authority"
    },
    {
      "id": "EXT_MODEL_TOOL_SERVICES",
      "access": "OUTBOUND_FROM_Z2_TOOL_GATEWAY",
      "rule": "no authority expansion; untrusted content boundary applies"
    }
  ],
  "cross_environment_rules": [
    "No non-production environment can write LIVE/CANARY authoritative state.",
    "LIVE/CANARY credentials are never copied into DEV/TEST/RESEARCH/DEMO/SHADOW.",
    "Production-derived market data may be replicated read-only downward only when licensing and privacy rules permit.",
    "Execution/account/order state does not flow downward except sanitized/replay fixtures explicitly produced for testing.",
    "Models/config/code promote upward by immutable artifact/version reference, never by mutable local state.",
    "Promotion never carries ambient credentials.",
    "User preferences may be replicated only through governed configuration migration, not hidden memory.",
    "Backups remain environment-scoped; restore into a different environment requires explicit transformation/sanitization."
  ],
  "environment_promotion": {
    "artifact_first": true,
    "required_evidence": [
      "immutable build/model/config artifact identity",
      "test/evaluation evidence",
      "security/risk compatibility",
      "environment-specific configuration validation",
      "rollback target",
      "required Human Gate for later high-risk promotions"
    ],
    "rule": "Promotion changes deployment eligibility, not agent/risk authority."
  },
