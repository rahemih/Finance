      "credential_class": "TEST_ONLY",
      "promotion_target": "RESEARCH_OR_DEMO"
    },
    {
      "id": "RESEARCH",
      "purpose": "historical analysis/backtest/experimentation",
      "real_market_data": "READ_ONLY_ALLOWED_IF_LICENSED",
      "real_account_access": "FORBIDDEN",
      "execution_capability": "NONE",
      "credential_class": "RESEARCH_READ_ONLY",
      "promotion_target": "DEMO"
    },
    {
      "id": "DEMO",
