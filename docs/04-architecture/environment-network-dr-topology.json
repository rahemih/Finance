  "geography_dependency": "NONE",
  "principles": [
    "environment isolation is authority isolation, not naming only",
    "public/user ingress never reaches execution or secrets directly",
    "provider/broker integration is mediated by controlled adapters",
    "cross-environment writes are forbidden by default",
    "recovery does not expand authority",
    "reconciliation precedes resumed risk-increasing execution",
    "country and cloud vendor are not architecture dependencies"
  ],
  "environments": [
