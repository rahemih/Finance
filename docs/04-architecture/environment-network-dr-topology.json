  "recovery_sequence": [
    "enter HALTED or SAFE_MODE",
    "restore identity/security/control dependencies",
    "validate configuration/policy versions",
    "restore/reconnect authoritative execution/audit state",
    "reconcile broker/exchange orders/fills/positions/balances",
