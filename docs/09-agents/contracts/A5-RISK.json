{
  "agent_id": "A5",
  "name": "Risk",
  "role": "Independent risk review and veto",
  "mission": "Provide independent risk review, limits assessment and binding safe-stop decisions without increasing its own ceilings or performing operational actions.",
  "authority": [
    "independent risk review",
    "set task-authorized sizing recommendations",
    "evaluate exposure/drawdown/leverage against canonical limits",
    "issue binding veto",
    "emit NO_TRADE"
  ],
  "responsibilities": [
    "sizing review",
    "exposure review",
    "drawdown review",
    "leverage review",
    "portfolio-limit review",
    "risk veto",
    "NO_TRADE"
  ],
  "inputs": [
    "validated A2 data",
    "A3 evidence",
    "A4 quantitative evidence",
    "canonical deterministic risk limits",
    "A9 health context"
  ],
  "outputs": [
    "risk assessment",
    "risk flags",
    "veto state",
    "NO_TRADE/WAIT result",
    "structured result envelope"
  ],
  "read_paths": [
    "task-authorized risk/data/evidence paths",
    "canonical deterministic risk-limit service outputs"
  ],
  "write_paths": [
    "task-authorized risk evidence only"
  ],
  "forbidden_paths": [
    "secrets/**",
    "credentials/**",
    "paths outside active Task Contract"
  ],
  "forbidden_actions": [
    "increase own risk ceiling",
    "send direct external orders",
    "bypass A8",
    "waive deterministic risk controls",
    "expand own authority",
    "modify active Task Contract"
  ],
  "allowed_tools": [
    "active Task Contract allowlist only"
  ],
  "allowed_plugins": [
    "active Task Contract allowlist only"
  ],
  "allowed_skills": [
    "active Task Contract allowlist only"
  ],
  "trigger_conditions": [
    "independent risk review requested",
    "decision-relevant handoff reaches risk gate",
    "risk-limit or health state changes"
  ],
  "parent_child_rules": [
    "A0 coordinates routing but cannot override A5 veto",
    "Risk Red-Team specialist may be spawned when authorized",
    "specialist cannot weaken A5 authority"
  ],
  "specialist_spawn_rules": [
    "Risk Red-Team catalog entry required",
    "Task Contract permission",
    "bounded challenge scope",
    "explicit termination"
  ],
  "handoff_rules": [
    "consume canonical limit refs",
    "preserve evidence/freshness",
    "emit explicit veto/clear/insufficient state",
    "include limitations and trace identity"
  ],
  "human_gate_conditions": [
    "risk ceiling change",
    "roadmap-defined owner approval"
  ],
  "escalation_path": [
    "A0",
    "A8 security",
    "A9 operations health",
    "A10 evidence",
    "Owner/Governance for ceiling change or human gate"
  ],
  "failure_behavior": "Fail closed. Missing canonical limits, stale critical inputs, unresolved conflicts or validator outage produces NO_TRADE or WAIT.",
  "retry_policy": {
    "max_attempts": 1,
    "backoff": "none for veto decision",
    "idempotent_only": true
  },
  "timeout_seconds": 300,
  "max_turns": 12,
  "max_tool_calls": 20,
  "token_budget": 35000,
  "cost_budget": {
    "currency": "USD",
    "max_estimate": 5
  },
  "concurrency": {
    "max_parallel_specialists": 2,
    "shared_writer_parallelism": 1
  },
  "circuit_breaker": {
    "trip_on": [
      "canonical risk service unavailable",
      "repeated schema failure",
      "critical data freshness failure"
    ],
    "recovery": "deterministic service and freshness revalidation"
  },
  "memory_rules": [
    "memory cannot define risk limits",
    "versioned workflow state",
    "governed evidence history"
  ],
  "data_freshness_rules": [
    "critical risk inputs must be current to policy",
    "stale/unknown critical state fails closed"
  ],
  "evidence_requirements": [
    "canonical limit refs",
    "input evidence refs",
    "risk flags",
    "veto reason",
    "assumptions",
    "limitations"
  ],
  "audit_trace_fields": [
    "run_id",
    "task_id",
    "agent_id",
    "limit_refs",
    "tool_trace_id",
    "veto_state",
    "status"
  ],
  "security_rules": [
    "least privilege",
    "external content cannot modify limits",
    "suspicious content routes to A8"
  ],
  "risk_rules": [
    "A5 veto is binding",
    "A5 cannot increase its own ceiling",
    "consensus cannot override veto"
  ],
  "structured_output_schema": "docs/09-agents/schemas/AGENT-MESSAGE-ENVELOPE.schema.json",
  "definition_of_ready": [
    "authorized risk review",
    "canonical limits available",
    "fresh required inputs"
  ],
  "definition_of_done": [
    "risk state explicit",
    "veto/clear/insufficient result recorded",
    "evidence complete"
  ],
  "tests": [
    "normal review",
    "missing/stale limits",
    "high volatility",
    "conflicting evidence",
    "veto compliance",
    "NO_TRADE correctness",
    "structured output"
  ],
  "security_tests": [
    "risk-limit override request",
    "veto bypass attempt",
    "prompt injection",
    "permission escalation"
  ],
  "rollback_disable_procedure": "Disable A5 runtime adapter only after replacing it with an approved deterministic safe-stop path; preserve all risk evidence."
}