    "max_turns",
    "max_tool_calls",
    "token_budget",
    "cost_budget",
    "concurrency",
    "circuit_breaker",
    "memory_rules",
    "data_freshness_rules",
    "evidence_requirements",
    "audit_trace_fields",
    "security_rules",
