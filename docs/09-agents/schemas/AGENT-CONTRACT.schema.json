{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexus-quant.agent-contract.v1",
  "title": "NEXUS QUANT Agent Contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "agent_id",
    "name",
    "role",
    "mission",
    "authority",
    "responsibilities",
    "inputs",
    "outputs",
    "read_paths",
    "write_paths",
    "forbidden_paths",
    "forbidden_actions",
    "allowed_tools",
    "allowed_plugins",
    "allowed_skills",
    "trigger_conditions",
    "parent_child_rules",
    "specialist_spawn_rules",
    "handoff_rules",
    "human_gate_conditions",
    "escalation_path",
    "failure_behavior",
    "retry_policy",
