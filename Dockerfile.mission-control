FROM python:3.13-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 NQ_HOST=0.0.0.0 NQ_DATA_PATH=/data/nq-events.sqlite3
COPY scripts/automation/mission_control_server.py scripts/automation/agent_trace.py scripts/automation/mission_control_runtime.py scripts/automation/mission_control_launcher.py ./scripts/automation/
COPY apps/agent-mission-control/ ./apps/agent-mission-control/
RUN useradd --system --uid 10001 --create-home nq && mkdir -p /data && chown 10001:10001 /data
USER nq
EXPOSE 10000
CMD ["python","scripts/automation/mission_control_server.py"]
