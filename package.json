{
  "name": "nexus-quant",
  "version": "0.0.0",
  "private": true,
  "description": "NEXUS QUANT governed polyglot monorepo root",
  "packageManager": "pnpm@11.28.4",
  "engines": {
    "node": "24.21.0",
    "pnpm": "11.28.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.28.4",
      "onFail": "error"
    }
  },
  "scripts": {
    "doctor": "python scripts/dev/doctor.py",
    "bootstrap": "python scripts/dev/bootstrap.py",
    "check:fast": "python scripts/dev/local_gate.py fast",
    "check:full": "python scripts/dev/local_gate.py full",
    "test:foundation": "python -m unittest discover -s tests/foundation -p \"test_*.py\" -v",
    "hooks:install": "python scripts/dev/install_hooks.py",
    "test:p05": "python -m unittest discover -s tests/p05 -p \"test_*.py\" -v"
  }
}
